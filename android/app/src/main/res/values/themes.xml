<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
    深灰色主题，无 ActionBar。
    使用 Theme.AppCompat.NoActionBar 作为父主题，
    兼容 Android 4.4 (API 19)。
    -->
    <style name="Theme.FntvApp" parent="Theme.AppCompat.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- 窗口背景 -->
        <item name="android:windowBackground">@color/bg_dark</item>

        <!-- 让 Dialog / Popup 也用深色 -->
        <item name="android:alertDialogTheme">@style/DarkDialog</item>

        <!-- 本地 checkbox / switch 样式（打进 APK，规避车机 ROM 平台图缺失导致的选中图标空白） -->
        <item name="checkboxStyle">@style/FntvCheckBox</item>
        <item name="switchStyle">@style/FntvSwitch</item>
    </style>

    <!-- 本地 CheckBox：用自带矢量对勾，避免平台 checkbox_on_background 在车机 ROM 缺失 -->
    <style name="FntvCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/bg_checkbox</item>
    </style>

    <!-- 本地 Switch：用自带轨道/滑块，避免平台 switch 图在车机 ROM 缺失 -->
    <style name="FntvSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
    </style>

    <!-- 弹幕设置等自定义 Dialog 主题：继承应用深色风格 + 本地 checkbox/switch 样式 -->
    <style name="Theme.FntvApp.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/bg_card</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="checkboxStyle">@style/FntvCheckBox</item>
        <item name="switchStyle">@style/FntvSwitch</item>
    </style>

    <!-- 深色对话框主题 -->
    <style name="DarkDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/bg_card</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="checkboxStyle">@style/FntvCheckBox</item>
        <item name="switchStyle">@style/FntvSwitch</item>
    </style>

    <!-- 遥控器焦点高亮：配合 ?attr/selectableItemBackground 默认有涟漪/高亮 -->
</resources>
